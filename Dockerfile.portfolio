FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /workspace
COPY pom.xml ./
RUN mvn -q -DskipTests dependency:go-offline
COPY src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
RUN useradd --system --uid 10001 appuser
COPY --from=build /workspace/target/SmartPAI-0.0.1-SNAPSHOT.jar /app/app.jar
COPY docs /app/docs
RUN mkdir -p /app/logs && chown -R appuser:appuser /app
USER appuser
ENV SPRING_PROFILES_ACTIVE=portfolio-demo
EXPOSE 8081
ENTRYPOINT ["java", "-Xms64m", "-Xmx256m", "-Xss512k", "-XX:MaxMetaspaceSize=128m", "-XX:ReservedCodeCacheSize=64m", "-XX:+UseSerialGC", "-jar", "/app/app.jar"]
