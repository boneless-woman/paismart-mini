SPRING_PROFILES_ACTIVE=portfolio-demo
PORT=8080

# Neon: use the pooled JDBC connection string and require SSL.
DATABASE_URL=jdbc:postgresql://your-neon-host/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=replace-me

JWT_SECRET_KEY=replace-with-base64-32-byte-secret
DEEPSEEK_API_KEY=replace-me
EMBEDDING_API_KEY=replace-me

PORTFOLIO_DEMO_USERNAME=portfolio_demo
PORTFOLIO_DEMO_PASSWORD=replace-with-a-public-demo-password
SECURITY_ALLOWED_ORIGINS=https://your-project.pages.dev

PORTFOLIO_DEMO_PER_MINUTE=6
PORTFOLIO_DEMO_DAILY_REQUESTS=100
PORTFOLIO_DEMO_DAILY_TOKEN_LIMIT=60000
PORTFOLIO_DEMO_MAX_QUESTION_LENGTH=500
DEEPSEEK_MAX_TOKENS=800
